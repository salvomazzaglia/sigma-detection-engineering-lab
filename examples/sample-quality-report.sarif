{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "runs": [
    {
      "invocations": [
        {
          "commandLine": "sigma-detection-lab validate",
          "executionSuccessful": true
        }
      ],
      "properties": {
        "category": "detection-engineering-quality",
        "disclaimer": "This artefact makes no claim of production readiness. Queries, mappings, and metrics require environment-specific validation before operational use.",
        "isVulnerabilityFinding": false,
        "note": "These results describe the quality of detection content. They are not vulnerability findings and carry no security severity.",
        "productionReady": false
      },
      "results": [],
      "tool": {
        "driver": {
          "informationUri": "https://github.com/salvomazzaglia/sigma-detection-engineering-lab",
          "name": "sigma-detection-engineering-lab",
          "properties": {
            "category": "detection-engineering-quality",
            "isVulnerabilityFinding": false,
            "note": "These results describe the quality of detection content. They are not vulnerability findings and carry no security severity."
          },
          "rules": [],
          "semanticVersion": "1.0.0",
          "version": "1.0.0"
        }
      }
    }
  ],
  "version": "2.1.0"
}
